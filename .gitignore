# Dependencies
# No trailing slash: "node_modules/" matches only directories, so a *symlink*
# named node_modules slips past it and can be committed (see the symlinks
# removed in this commit). Without the slash this matches either.
node_modules

# Build output
dist/
build/
.vite/

# Environment variables (NEVER commit these — they contain secrets)
.env
.env.local

# Uploaded files (user content, not code)
uploads/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Prisma
prisma/*.db

# TypeScript build info
*.tsbuildinfo
