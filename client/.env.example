# Vite reads env vars prefixed with VITE_ at build time and inlines them
# into the bundle. Copy this file to .env.local for local overrides (gitignored).
#
# Leave both blank to use the Vite proxy defined in vite.config.ts when
# running `npm run dev` — frontend hits /api and /socket.io which are
# forwarded to http://localhost:5001.

# Absolute URL of the deployed backend API, including the /api path.
# Example: https://cropbid-api.onrender.com/api
VITE_API_URL=

# Origin of the deployed backend (no path) for Socket.io.
# Example: https://cropbid-api.onrender.com
VITE_SOCKET_URL=

# Sign in with Google: the OAuth "Web application" client id from Google Cloud
# Console (APIs & Services > Credentials). Must be the same id the API has as
# GOOGLE_CLIENT_ID. Add every origin the site is served from (production and
# http://localhost:5173 for dev) under "Authorised JavaScript origins".
# Leave blank and the sign-in window shows no Google button.
VITE_GOOGLE_CLIENT_ID=
