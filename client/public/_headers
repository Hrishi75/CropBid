# Cloudflare response headers, copied into dist/ by the build and read on
# deploy (never served as a file). Mirrors the headers block in vercel.json.

# Vite fingerprints every file in /assets, so a changed file gets a new name
# and these can be cached for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/robots.txt
  Cache-Control: public, max-age=3600

/llms.txt
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600
