// =============================================================================
// CropBid Database Schema — Prisma ORM
// =============================================================================
//
// This file defines ALL database tables, their columns, relationships, and
// constraints. It is the single source of truth for your data model.
//
// KEY CONCEPTS:
// - Each `model` becomes a PostgreSQL table
// - `@id` marks the primary key
// - `@unique` adds a unique constraint
// - `@default(uuid())` auto-generates UUIDs (safer than auto-increment IDs)
// - `@relation` defines foreign key relationships
// - `enum` creates PostgreSQL enum types (fixed set of valid values)
// - `String[]` uses PostgreSQL's native array type
// - `Json` stores flexible JSON data
//
// After changing this file, run:
//   npx prisma migrate dev --name describe_your_change
//   npx prisma generate
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// Enums — Fixed sets of valid values
// =============================================================================
// WHY ENUMS INSTEAD OF STRINGS?
// Enums are enforced at the database level. If you try to insert role="HACKER",
// PostgreSQL will reject it. With plain strings, any typo would be silently accepted.

enum Role {
  FARMER
  BUYER
  CONSUMER // Individual end-user buying any quantity directly from a farmer, no bidding
  ADMIN
}

enum Currency {
  INR // Indian Rupee (₹) — default
  USD // US Dollar ($)
  EUR // Euro (€)
  GBP // British Pound (£)
}

enum Language {
  EN // English
  HI // Hindi
  MR // Marathi
}

enum Unit {
  KG      // Kilogram — universal
  QUINTAL // 100 kg — common in Indian mandis
  TONNE   // 1000 kg — for bulk/export
}

enum QualityGrade {
  A // Premium quality
  B // Standard quality
  C // Economy quality
}

enum ListingStatus {
  ACTIVE     // Open for bids
  IN_AUCTION // Multiple buyers bidding live
  SOLD       // Deal closed
  EXPIRED    // Past expiry date, no deal
}

enum CompanyType {
  PROCESSOR      // Food processing companies
  FMCG           // Fast-moving consumer goods
  RESTAURANT     // Restaurant chains, cafés, cloud kitchens
  EXPORTER       // Export companies
  RETAILER       // Retail chains
  WHOLESALER     // Bulk traders buying lots to redistribute
  SMALL_BUSINESS // Sweet shops, tiffin services, caterers — small recurring volumes
}

// Which kind of seller a partner is. Drives the fulfilment tier (a local shop
// quotes same-day and higher, a farmer second-day and cheaper, a wholesaler
// bulk with minimums) and which compliance fields the application must carry
// (a shop selling food needs an FSSAI licence; a farmer selling raw produce
// does not).
enum SellerType {
  FARMER     // Grows what they sell
  LOCAL_SHOP // Neighbourhood shop holding same-day stock
  WHOLESALER // Bulk stock, lowest unit price, minimum order applies
}

// Lifecycle of a partner (seller or buyer) application. Nothing a partner does
// reaches the marketplace until an admin moves them to APPROVED — dashboards
// and mutating routes are gated on this, client- and server-side.
enum PartnerStatus {
  SUBMITTED    // Application in, waiting for first review
  UNDER_REVIEW // An admin has picked it up
  NEEDS_INFO   // Sent back to the applicant — statusNote says what's missing
  APPROVED     // Live: dashboard and marketplace unlocked
  REJECTED     // Turned down — statusNote says why
  SUSPENDED    // Was live, pulled by an admin
}

enum AgentType {
  FARMER_AGENT
  BUYER_AGENT
}

enum NegotiationStyle {
  AGGRESSIVE   // Push hard, small concessions
  BALANCED     // Fair market rate, reasonable concessions
  CONSERVATIVE // Close deals fast, near asking price
}

enum BidStatus {
  PENDING   // Waiting for response
  ACCEPTED  // Farmer accepted
  REJECTED  // Farmer rejected
  COUNTERED // Farmer counter-offered
  EXPIRED   // Timed out
}

enum PaymentStatus {
  AWAITING_PAYMENT // Transaction created, buyer has not paid yet (Razorpay order open)
  ESCROW           // Money captured & held by platform
  RELEASED         // Paid to farmer
  REFUNDED         // Returned to buyer
}

enum DeliveryStatus {
  PENDING    // Not yet shipped
  IN_TRANSIT // On the way
  DELIVERED  // Reached buyer
  CONFIRMED  // Buyer confirmed receipt
}

enum NegotiationOutcome {
  DEAL        // Agreement reached
  NO_DEAL     // Could not agree
  IN_PROGRESS // Still negotiating
}

// Buyer requirements — the reverse marketplace. A requirement runs the mirror
// image of a Listing's lifecycle: it opens with a quantity, gets whittled down
// by partial fills, and closes at zero.
enum RequirementStatus {
  OPEN      // Accepting fills and offers
  FULFILLED // remainingQuantity hit 0 — every unit is spoken for
  CLOSED    // Buyer withdrew it before it filled
  EXPIRED   // neededBy passed with quantity still open.
            // NOTE: nothing sets this automatically — there is no scheduler in
            // this codebase (same story as ListingStatus.EXPIRED). The feed and
            // both accept paths reject past-deadline rows lazily instead.
}

enum RequirementOfferStatus {
  PENDING   // Awaiting the buyer's decision
  ACCEPTED  // Buyer took it — a Listing + Bid + Transaction now exist
  REJECTED  // Buyer declined
  WITHDRAWN // Farmer pulled it before the buyer decided
  EXPIRED   // Requirement filled or closed underneath it
}

// The two product paths, not a style flag: an INSTANT row is born ACCEPTED (the
// farmer took the buyer's posted price), a COUNTER row is born PENDING and needs
// the buyer's sign-off.
enum RequirementOfferKind {
  INSTANT
  COUNTER
}

// =============================================================================
// Model 1: User — The core identity
// =============================================================================
// Every person on the platform is a User. Their role determines what they can do.
// A User has either a FarmerProfile or BuyerProfile (or neither if Admin).

model User {
  id          String   @id @default(uuid())
  name        String
  // Phone is the primary contact/login identifier (required at signup);
  // email is optional. Both stay nullable at the DB level for legacy rows.
  email       String?  @unique
  // Nullable since phone+OTP signup landed: a shopper who has only ever signed
  // in with a code has NO password, and login must refuse the password path
  // for those accounts rather than comparing against an empty hash.
  password    String?  // Hashed with bcrypt — NEVER store plain text
  role        Role
  phone       String?  @unique
  location    String?
  country     String   @default("India")
  currency    Currency @default(INR)
  language    Language @default(EN)
  avatar      String?  // URL to uploaded avatar image
  trustScore  Float    @default(50) // 0-100, builds with successful transactions

  // Admin can suspend an account. A suspended user can't log in or refresh their
  // session (both flows reject with 403), and suspending clears refreshToken so
  // any live session dies at its next refresh. Reversible via the admin panel.
  suspended   Boolean  @default(false)

  // Refresh token for JWT auth — stored hashed, null when logged out
  // WHY STORE THIS? So we can invalidate sessions on logout (set to null)
  refreshToken String?

  // Password reset — we store only the SHA-256 hash of the emailed token, so a
  // database leak can't be used to take over accounts. Single-use: both fields
  // are cleared as soon as the reset succeeds. Expires after 1 hour.
  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations — these don't create columns, they define how models connect
  farmerProfile FarmerProfile?
  buyerProfile  BuyerProfile?
  agentConfig   AgentConfig?
  bids          Bid[]          // A buyer's bids
  farmerTransactions Transaction[] @relation("FarmerTransactions")
  buyerTransactions  Transaction[] @relation("BuyerTransactions")
  notifications Notification[]
  equipmentEnquiries EquipmentEnquiry[] // Machinery leads this user has raised
  buyerRequirements BuyerRequirement[]  // Demand this buyer has posted
  requirementOffers RequirementOffer[]  // Responses this farmer has sent
}

// =============================================================================
// Model 1b: PendingSignup — a buyer signup waiting on its email OTP
// =============================================================================
// Buyers must prove they control their email before an account exists. The
// submitted details park here until the 6-digit code comes back; only then is a
// User row written.
//
// WHY NOT A "verified" FLAG ON USER? Because the User table's unique indexes on
// email and phone are first-come-first-served. An unverified row would let
// anyone type a stranger's address and permanently lock that person out of ever
// registering it. Nothing here is unique against User, so parking a signup
// reserves nothing.
//
// The password arrives already bcrypt-hashed — plaintext never lands in a
// column, even a short-lived one. Rows are deleted on success and swept on
// expiry (see pruneExpiredPendingSignups).
model PendingSignup {
  id        String   @id @default(uuid())
  // Unique so a resend or a retyped signup REPLACES the earlier attempt rather
  // than leaving several live codes for one address.
  email     String   @unique // normalized (lowercased)
  phone     String            // normalized (digits, optional leading +)
  name      String
  password  String            // bcrypt hash, never plaintext
  role      Role
  country   String   @default("India")
  currency  Currency @default(INR)
  language  Language @default(EN)

  // SHA-256 of the 6-digit code — see utils/signupOtp.ts for why not bcrypt.
  codeHash   String
  expiresAt  DateTime
  attempts   Int      @default(0) // wrong guesses so far; capped at 5
  lastSentAt DateTime @default(now()) // drives the resend cooldown

  createdAt DateTime @default(now())

  // Sweeping expired rows is a range scan over this column.
  @@index([expiresAt])
}

// =============================================================================
// Model 1c: PhoneChallenge — a live phone+OTP sign-in attempt
// =============================================================================
// The passwordless front door. Someone types a phone number, a 6-digit code
// goes out by SMS, and the code coming back both proves the number and signs
// them in — creating the account on first use.
//
// WHY NOT REUSE PendingSignup? That row parks a full set of signup details
// behind an EMAIL code and always creates a User. This one carries no details
// at all (the number IS the identity) and usually logs into an account that
// already exists. Different lifecycle, different table.
//
// Only the SHA-256 hash of the code is stored — see utils/phoneOtp.ts for why
// a hash rather than bcrypt is the right call for a short-lived 6-digit code.
// Rows are deleted on success and swept on expiry.
model PhoneChallenge {
  id         String   @id @default(uuid())
  // Unique: asking for another code REPLACES the live one, so a number never
  // has two valid codes at once.
  phone      String   @unique
  codeHash   String

  // Role to give the account if this code creates one. Consumers self-serve;
  // FARMER/BUYER come from the partner flow and still face the approval gate.
  // ADMIN is never accepted here.
  intendedRole Role   @default(CONSUMER)

  attempts   Int      @default(0)
  expiresAt  DateTime
  lastSentAt DateTime @default(now()) // drives the resend cooldown

  createdAt  DateTime @default(now())

  @@index([expiresAt])
}

// =============================================================================
// Model 2: FarmerProfile — the SELLER profile (farmer, local shop, wholesaler)
// =============================================================================
// WHY SEPARATE FROM USER?
// Sellers have trade-specific fields (farm size, licences, categories).
// Buyers have company-specific fields (company name, GST, volume).
// Putting both in User would create a table full of nullable columns.
//
// NAMING DEBT: the model keeps its original FarmerProfile name (and the
// Role value stays FARMER) because renaming would touch every relation,
// include and requireRole in the codebase for zero behaviour change. Read
// "FarmerProfile" as "SellerProfile" — `sellerType` says which kind this row
// is, and the farm-only columns are nullable because a shop has no acreage.

model FarmerProfile {
  id             String     @id @default(uuid())
  userId         String     @unique // One user = one profile
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  sellerType     SellerType @default(FARMER)

  // --- Application lifecycle (see PartnerStatus) ---
  // Existing rows were backfilled APPROVED in the migration: they were live
  // before the approval gate existed, and locking them out would be a regression.
  status       PartnerStatus @default(SUBMITTED)
  statusNote   String?       // Reviewer's note — what's missing (NEEDS_INFO) or why (REJECTED)
  submittedAt  DateTime      @default(now()) // Last (re)submission — drives queue ordering + SLA
  reviewedAt   DateTime?
  reviewedById String?       // Admin userId — who made the call (see also AuditLog)

  // --- Farm fields (FARMER only; a shop or wholesaler has neither) ---
  farmSizeAcres  Float?   // Farm size in acres
  cropsGrown     String[] // Doubles as "categories stocked" for shops/wholesalers

  // --- Shop / wholesale fields (LOCAL_SHOP and WHOLESALER) ---
  businessName  String? // Shop or firm name — the consumer-facing identity
  shopType      String? // kirana / vegetable / dairy / bakery / general / other
  address       String? // Street address; city lives on User.location
  fssaiLicense  String? // Food licence — required before a shop's stock can go live
  gstin         String? // Optional for shops (most are under threshold), expected for wholesalers
  minOrderValue Float?  // WHOLESALER: minimum order value in account currency
  leadTimeDays  Int?    // WHOLESALER: days from order to dispatch

  // Location
  country        String   @default("India")
  state          String   // e.g., "Maharashtra", "Punjab", "California"

  // India-specific fields (shown conditionally when country is India)
  fpoName        String?  // Farmer Producer Organization name
  apmcLicense    String?  // Agricultural Produce Market Committee license

  // Certification
  organicCertified  Boolean @default(false)
  certificationBody String? // "NPOP" (India), "USDA Organic" (US), "EU Organic" (Europe)

  bankDetails    Json?    // Flexible JSON for bank info (varies by country)
  verified       Boolean  @default(false) // Admin-verified (legacy badge; the gate is `status`)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A farmer can have many listings
  listings Listing[]

  // The admin review queue scans by status, oldest submission first.
  @@index([status, submittedAt])
}

// =============================================================================
// Model 3: BuyerProfile — Company/procurement details
// =============================================================================

model BuyerProfile {
  id                       String      @id @default(uuid())
  userId                   String      @unique
  user                     User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyName              String
  companyType              CompanyType
  country                  String      @default("India")

  // --- Application lifecycle — same machine as FarmerProfile.status ---
  // Existing rows backfilled APPROVED in the migration.
  status       PartnerStatus @default(SUBMITTED)
  statusNote   String?
  submittedAt  DateTime      @default(now())
  reviewedAt   DateTime?
  reviewedById String?

  // Tax ID label changes by country:
  //   India = GST Number, US = EIN, EU = VAT Number
  taxId                    String?

  annualProcurementVolume  String?     // e.g., "500-1000 tonnes"
  outletCount              Int?        // RESTAURANT chains: how many kitchens take delivery
  verified                 Boolean     @default(false) // Legacy badge; the gate is `status`

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, submittedAt])
}

// =============================================================================
// Model 4: Listing — A crop for sale
// =============================================================================
// This is what farmers create to sell their produce.
// Buyers browse listings and place bids on them.

model Listing {
  id             String        @id @default(uuid())

  // Which farmer owns this listing
  farmerId       String
  farmer         FarmerProfile @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  // Crop details
  cropName       String        // e.g., "Rice", "Wheat", "Cotton"
  cropVariety    String?       // e.g., "Basmati", "Sharbati", "Shankar-6"
  quantity       Float         // Total quantity on offer (fixed at creation)
  remainingQuantity Float      // Stock left for direct sale — decremented on each consumer purchase
  unit           Unit          @default(KG)
  qualityGrade   QualityGrade

  // Pricing — farmer sets a range for bidding
  // pricePerUnitMin = floor price (won't sell below this)
  // pricePerUnitMax = ideal price (what farmer hopes to get)
  pricePerUnitMin Float
  pricePerUnitMax Float
  currency       Currency      @default(INR)

  // Direct-to-consumer retail sale — a separate fixed-price channel that runs
  // alongside bidding. When enabled, consumers can instant-buy any quantity up
  // to remainingQuantity at retailPricePerUnit, no negotiation involved.
  directSaleEnabled  Boolean   @default(false)
  retailPricePerUnit Float?

  // True when this row exists only to carry a buyer-requirement fill into the
  // Transaction pipeline — Transaction.listingId and .bidId are both NOT NULL,
  // so a fill needs a Listing to hang off. Born SOLD with remainingQuantity 0;
  // it is never inventory, so listing.service and analytics filter it out.
  // Same marker technique as Bid.isDirectPurchase.
  isRequirementFill  Boolean   @default(false)

  // Dates
  harvestDate    DateTime?     // When the crop was/will be harvested
  expiryDate     DateTime?     // When this listing expires

  // Description & media
  description    String?
  // Machine translations of `description`, written fire-and-forget AFTER the
  // row is saved (services/translation.service.ts). `description` always holds
  // the original as the farmer wrote it; the column matching descriptionLang
  // holds an exact copy of it, which is what makes the worker idempotent —
  // a row is already done iff description<Lang> === description, so no job
  // table or translatedAt column is needed.
  //
  // Any of these may stay null forever (Sarvam unconfigured, over quota, down,
  // or the text too long to translate safely). Readers fall back to
  // `description` — see client/src/utils/localized.ts.
  descriptionEn   String?
  descriptionHi   String?
  descriptionMr   String?
  descriptionLang Language?    // Language the farmer actually wrote in
  images         String[]      // Array of uploaded image URLs
  labReportUrl   String?       // Lab quality report

  // Classification
  organic        Boolean       @default(false)
  location       String        // City/town
  country        String        @default("India")
  state          String        // State/province

  status         ListingStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  bids          Bid[]
  transactions  Transaction[]
  negotiations  Negotiation[]
  requirementOffer RequirementOffer? // Set when this listing is a requirement fill
}

// =============================================================================
// Model 4b: BuyerRequirement — A buyer's standing demand
// =============================================================================
// The mirror image of a Listing: "I want 500 qtl cotton at ₹7,000/qtl, delivered
// to Nagpur". Farmers either take that price outright (an INSTANT offer, which
// closes the deal on the spot) or counter with their own price (a COUNTER offer
// the buyer signs off on).
//
// WHY buyerId → User.id AND NOT BuyerProfile.id?
// Listing.farmerId points at FarmerProfile.id, which forces every caller to
// resolve profile→user before it can do anything. But Bid.buyerId,
// Transaction.farmerId/buyerId, Notification.userId and AuditLog.actorId ALL
// target User.id, and so does req.user.userId. Every single thing this model
// feeds needs the User id; nothing needs the profile id. Pointing at User makes
// the ownership check a bare `requirement.buyerId === userId` instead of a join.
// Company details are still one hop away via User.buyerProfile.

model BuyerRequirement {
  id                String            @id @default(uuid())

  buyerId           String
  buyer             User              @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  cropName          String            // e.g., "Cotton"
  cropVariety       String?           // e.g., "Shankar-6"

  quantity          Float             // Total demand, fixed at creation
  remainingQuantity Float             // Decremented on every fill; 0 → FULFILLED
  unit              Unit              @default(QUINTAL)
  qualityGrade      QualityGrade      // Minimum grade the buyer will accept

  // A single number, not a range: this is what the buyer will pay, and it is the
  // price an INSTANT fill executes at. Farmers who want more send a COUNTER.
  pricePerUnit      Float
  currency          Currency          @default(INR)

  // Where the goods must LAND. Deliberately separate from the fill listing's
  // location/state, which is where they ship FROM.
  deliveryLocation  String            // City/town, e.g. "Nagpur"
  deliveryState     String
  deliveryCountry   String            @default("India")
  neededBy          DateTime?         // Delivery deadline

  description       String?
  // Stored translations — see the matching block on Listing for the full
  // rationale. Same worker, same idempotence rule, same null-means-fall-back.
  descriptionEn     String?
  descriptionHi     String?
  descriptionMr     String?
  descriptionLang   Language?
  organic           Boolean           @default(false) // Buyer REQUIRES organic

  // Copied onto the auto-created Bid so a requirement deal carries the same
  // commercial terms a hand-placed bid does.
  paymentTerms      String?           // LC | NET7 | NET15 — validated at the API boundary
  deliveryTerms     String?           // FOB | CIF — validated at the API boundary

  status            RequirementStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offers RequirementOffer[]

  // The farmer feed is always "OPEN, newest first", usually narrowed by crop or
  // delivery state.
  @@index([status, createdAt])
  @@index([cropName, status])
  @@index([deliveryState, status])
  @@index([buyerId, createdAt])
}

// =============================================================================
// Model 4c: RequirementOffer — A farmer's response to a requirement
// =============================================================================
// Two kinds share one table because they share one lifecycle and one inbox:
//   INSTANT — farmer took the posted price. Created already ACCEPTED, with its
//             listing/bid/transaction materialised in the same DB transaction.
//   COUNTER — farmer's own price/quantity. Created PENDING; the buyer accepts
//             (which materialises the deal) or rejects.
//
// farmerId targets User.id for the same reason buyerId does above — the
// FarmerProfile id is looked up exactly once, inside the accept path, because
// that is the only place that needs it (Listing.farmerId).

model RequirementOffer {
  id            String                 @id @default(uuid())

  requirementId String
  requirement   BuyerRequirement       @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  farmerId      String
  farmer        User                   @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  kind          RequirementOfferKind
  quantity      Float
  pricePerUnit  Float
  totalAmount   Float                  // pricePerUnit × quantity, snapshotted.
                                       // The Transaction is money-of-record.
  currency      Currency               @default(INR)
  message       String?

  status        RequirementOfferStatus @default(PENDING)

  // Set the moment the offer becomes a real deal. Nullable because a PENDING /
  // REJECTED / WITHDRAWN offer never produces one. @unique means the database
  // itself refuses to let one offer mint two listings or two bids — a hard
  // backstop under the conditional-claim logic in the service.
  listingId     String?                @unique
  listing       Listing?               @relation(fields: [listingId], references: [id])
  bidId         String?                @unique
  bid           Bid?                   @relation(fields: [bidId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  respondedAt DateTime?                // When the buyer accepted/rejected

  @@index([requirementId, status])
  @@index([farmerId, createdAt])
}

// =============================================================================
// Model 5: AgentConfig — AI agent settings
// =============================================================================
// Each user gets ONE AI agent. This table stores how the agent should behave.
// The agent uses these settings when making automated decisions.

model AgentConfig {
  id               String           @id @default(uuid())
  userId           String           @unique
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  agentType        AgentType

  // Master toggle — is the agent active?
  autoNegotiate    Boolean          @default(true)
  active           Boolean          @default(true)

  // Price boundaries — the agent NEVER crosses these
  minPrice         Float?           // Farmer: won't sell below this
  maxPrice         Float?           // Buyer: won't pay above this

  // Buyer-specific: what crops to look for
  preferredCrops   String[]

  // Buyer-specific: quality requirements
  // Example JSON: { "minGrade": "B", "maxMoisture": 14, "pesticidesAllowed": false }
  qualityRequirements Json?

  // Max distance to consider (for logistics)
  maxDistanceKm    Int?

  // If bid price >= this threshold, auto-accept immediately
  autoAcceptThreshold Float?

  // How aggressive is the agent in negotiations?
  negotiationStyle NegotiationStyle @default(BALANCED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations — an agent can participate in many negotiations
  farmerNegotiations Negotiation[] @relation("FarmerAgent")
  buyerNegotiations  Negotiation[] @relation("BuyerAgent")
}

// =============================================================================
// Model 6: Bid — A buyer's offer on a listing
// =============================================================================
// When a buyer wants to purchase from a listing, they place a bid.
// The bid can be manual (buyer typed it) or automatic (AI agent placed it).

model Bid {
  id              String    @id @default(uuid())

  listingId       String
  listing         Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)

  buyerId         String
  buyer           User      @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  bidPricePerUnit Float     // Price per unit offered
  totalAmount     Float     // bidPricePerUnit × quantity
  quantity        Float     // How much the buyer wants

  currency        Currency  @default(INR)
  message         String?   // Optional message from buyer

  // Order fulfilment details, snapshotted at order time so the seller can
  // arrange delivery and reach the buyer. When the client doesn't collect
  // them (e.g. the one-tap consumer buy), the service falls back to the
  // buyer's profile phone/location.
  deliveryAddress String?
  contactPhone    String?
  paymentTerms    String?   // LC | NET7 | NET15 — validated at the API boundary
  deliveryTerms   String?   // FOB | CIF — validated at the API boundary

  // Was this bid placed by the AI agent or manually by the user?
  isAgentBid      Boolean   @default(false)

  // True for a consumer's instant fixed-price purchase (no negotiation) —
  // created directly with status ACCEPTED, skipping the PENDING bid flow.
  isDirectPurchase Boolean  @default(false)

  status          BidStatus @default(PENDING)
  counterPrice    Float?    // If farmer counters, this is their price

  createdAt  DateTime  @default(now())
  expiresAt  DateTime? // Bids can have a deadline

  // Relations
  transaction  Transaction?
  negotiation  Negotiation?
  requirementOffer RequirementOffer? // Set when this bid is a requirement fill
}

// =============================================================================
// Model 7: Transaction — A completed deal
// =============================================================================
// When a bid is accepted, a Transaction is created to track payment and delivery.
// This is the financial record of every deal on the platform.

model Transaction {
  id                String        @id @default(uuid())

  listingId         String
  listing           Listing       @relation(fields: [listingId], references: [id])

  bidId             String        @unique // One transaction per bid
  bid               Bid           @relation(fields: [bidId], references: [id])

  farmerId          String
  farmer            User          @relation("FarmerTransactions", fields: [farmerId], references: [id])

  buyerId           String
  buyer             User          @relation("BuyerTransactions", fields: [buyerId], references: [id])

  // Financial details
  finalPricePerUnit Float
  totalAmount       Float
  currency          Currency      @default(INR)

  // Platform fee — how CropBid makes money
  platformFeePercent Float        @default(2.0)  // 2% fee
  platformFeeAmount  Float                        // Calculated: totalAmount × 2%

  // Default stays ESCROW for a clean single-step enum migration (Postgres can't use
  // a freshly-added enum value as a DEFAULT in the same migration). The real initial
  // status for new deals is set explicitly to AWAITING_PAYMENT in transaction.service.ts.
  paymentStatus     PaymentStatus @default(ESCROW)
  deliveryStatus    DeliveryStatus @default(PENDING)

  // Razorpay (capture-only). Order is created when buyer initiates payment;
  // paymentId is set once the payment is verified/captured into the platform account.
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?

  createdAt DateTime @default(now())

  // Logistics
  shipment Shipment?
}

// =============================================================================
// Model 8: Negotiation — AI agent conversation record
// =============================================================================
// When agents negotiate, every round is recorded here as JSON.
// The `rounds` field stores an array of objects like:
// [
//   { round: 1, from: "farmer_agent", action: "counter", price: 2400, reasoning: "..." },
//   { round: 1, from: "buyer_agent",  action: "counter", price: 2350, reasoning: "..." },
//   { round: 2, from: "farmer_agent", action: "accept",  price: 2350, reasoning: "..." }
// ]
//
// WHY JSON INSTEAD OF A SEPARATE TABLE?
// Negotiation rounds are an append-only log always read as a whole.
// A separate NegotiationRound table would require JOINs and sorting.
// JSON array is simpler and faster for this use case.

model Negotiation {
  id             String             @id @default(uuid())

  listingId      String
  listing        Listing            @relation(fields: [listingId], references: [id], onDelete: Cascade)

  bidId          String             @unique
  bid            Bid                @relation(fields: [bidId], references: [id], onDelete: Cascade)

  farmerAgentId  String
  farmerAgent    AgentConfig        @relation("FarmerAgent", fields: [farmerAgentId], references: [id])

  buyerAgentId   String
  buyerAgent     AgentConfig        @relation("BuyerAgent", fields: [buyerAgentId], references: [id])

  // The negotiation log — see comment above for structure
  rounds         Json               @default("[]")

  finalOutcome   NegotiationOutcome @default(IN_PROGRESS)

  startedAt      DateTime           @default(now())
  endedAt        DateTime?          // Null while in progress
}

// =============================================================================
// Model 9: Notification — Real-time alerts
// =============================================================================
// Every important event creates a notification: new bid, bid accepted,
// agent action, transaction update, etc.
//
// Notifications are BOTH:
//   1. Saved to this table (so they persist if user is offline)
//   2. Sent via Socket.io in real-time (instant if user is online)

model Notification {
  id        String   @id @default(uuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      String   // e.g., "NEW_BID", "BID_ACCEPTED", "AGENT_ACTION"
  title     String   // e.g., "New bid on your Rice listing"
  message   String   // e.g., "Buyer X offered ₹2,400/quintal for 50 quintals"

  read      Boolean  @default(false)

  // Flexible payload for linking to relevant entities
  // Example: { "listingId": "abc", "bidId": "xyz" }
  data      Json?

  createdAt DateTime @default(now())
}

// =============================================================================
// Model 10: Waitlist — Early access signups
// =============================================================================

model Waitlist {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// =============================================================================
// Model: AuditLog — Tamper-evident record of sensitive actions
// =============================================================================
// Captures who did what on which entity. Used for security review, dispute
// resolution, and admin forensics. Append-only — never updated or deleted.
//
// actorId is nullable so system-initiated actions (cron jobs, webhooks) can
// still be recorded. entityType + entityId form a logical foreign key but
// are stored as plain strings so the log survives entity deletion.
//
// Indexed by (entityType, entityId) for entity history lookups and by
// actorId for "what did this user do" queries.

model AuditLog {
  id         String   @id @default(uuid())

  actorId    String?
  actorRole  String?  // Snapshot of role at action time (FARMER / BUYER / ADMIN / SYSTEM)

  action     String   // e.g., "bid.accept", "transaction.refund", "admin.user.update"
  entityType String   // e.g., "Bid", "Transaction", "User", "Listing"
  entityId   String   // ID of the affected entity

  // Diff / context — before/after values, request IP, user-agent, reason text, etc.
  metadata   Json?

  ip         String?
  userAgent  String?

  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

// =============================================================================
// Logistics Enums
// =============================================================================

enum LogisticsType {
  TRUCKING
  COLD_CHAIN
  LOCAL
  FREIGHT
  EXPORT
}

enum ShipmentStatus {
  PENDING_PICKUP
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
}

enum PaidBy {
  BUYER
  FARMER
  SPLIT
}

// =============================================================================
// Model 11: LogisticsPartner — Third-party transport providers
// =============================================================================

model LogisticsPartner {
  id                String         @id @default(uuid())
  name              String
  type              LogisticsType
  coverageRegions   String[]       // States/provinces covered
  coverageCountries String[]       // Countries covered
  vehicleTypes      String[]       // e.g., ["10-ton truck", "Reefer Van"]
  minQuantityKg     Float
  maxQuantityKg     Float
  costPerKmPerKg    Float          // Rate calculation base
  avgDeliveryDays   Int
  rating            Float          @default(4.0)
  contactEmail      String
  contactPhone      String
  apiEndpoint       String?        // For future API integration
  commissionPercent Float          @default(7.5) // CropBid earns 5-10%
  active            Boolean        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shipments Shipment[]
}

// =============================================================================
// Model 12: Shipment — Tracks a delivery from farmer to buyer
// =============================================================================

model Shipment {
  id                    String           @id @default(uuid())

  transactionId         String           @unique
  transaction           Transaction      @relation(fields: [transactionId], references: [id])

  logisticsPartnerId    String
  logisticsPartner      LogisticsPartner @relation(fields: [logisticsPartnerId], references: [id])

  pickupLocation        String
  pickupDate            DateTime
  deliveryLocation      String
  estimatedDeliveryDate DateTime
  actualDeliveryDate    DateTime?

  vehicleType           String
  vehicleNumber         String?
  driverName            String?
  driverPhone           String?

  distanceKm            Float
  totalWeightKg         Float
  transportCost         Float
  platformCommission    Float            // CropBid's cut from logistics
  currency              Currency         @default(INR)

  paidBy                PaidBy
  splitPercentBuyer     Float?           // Only used when paidBy = SPLIT

  status                ShipmentStatus   @default(PENDING_PICKUP)
  trackingUpdates       Json             @default("[]")
  proofOfDelivery       String?          // Photo URL

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =============================================================================
// EQUIPMENT MARKETPLACE — machines, pumps, pipes and implements
// =============================================================================
// A LEAD-GEN surface, deliberately NOT a checkout. CropBid lists what dealers
// stock, farmers raise an enquiry, and the dealer closes the sale offline. We
// never take payment, hold inventory, or own the warranty — high-ticket
// machinery is a completely different ops problem from perishable produce.
//
// Two ways a farmer gets a machine, and both matter in India:
//   SALE — outright purchase (pumps, pipes, sprayers are affordable)
//   RENT — day/hour hire, the Custom Hiring Centre model the government funds
//          through SMAM. A ₹6L tractor is out of reach for a smallholder who
//          will happily pay ₹1,200/day at sowing time.
// An Equipment row can offer either or both (see `mode`).

enum EquipmentCategory {
  TRACTOR    // Tractors and power tillers
  TILLAGE    // Rotavators, cultivators, ploughs, harrows
  HARVESTER  // Combine harvesters, reapers
  IRRIGATION // Pumps, pipes, sprinklers, drip sets
  SPRAYER    // Knapsack, boom and power sprayers
  THRESHER   // Threshers, winnowers, shellers
  POWER      // Motors, diesel engines, gensets
  TOOLS      // Hand implements and small attachments
}

enum EquipmentCondition {
  NEW
  USED
}

// What the dealer is willing to do with this machine.
enum EquipmentMode {
  SALE // Purchase only
  RENT // Hire only
  BOTH // Either — farmer picks on the enquiry
}

enum EnquiryIntent {
  SALE
  RENT
}

enum EnquiryStatus {
  NEW       // Raised, dealer not yet reached
  CONTACTED // Dealer has spoken to the farmer
  CLOSED    // Resolved either way
}

// =============================================================================
// Model 13: EquipmentDealer — Third-party machinery sellers & hire centres
// =============================================================================
// Modelled like LogisticsPartner: an offline partner CropBid curates, NOT a
// User with a login. Dealers have no account to sign into yet — we pass them
// leads over the phone. If dealer self-service is ever built, this row gains an
// optional userId rather than being replaced.

model EquipmentDealer {
  id            String   @id @default(uuid())
  name          String
  location      String   // City/town
  state         String
  country       String   @default("India")

  contactPhone  String   // Revealed to a farmer only once they raise an enquiry
  contactEmail  String?

  // Curated trust signals — CropBid vouches for verified dealers.
  verified      Boolean  @default(false)
  rating        Float    @default(4.0)

  // Some dealers are empanelled under the government's SMAM subsidy scheme,
  // which means a farmer buying through them can claim 40–50% back. Surfacing
  // this is a genuine reason to pick one dealer over another.
  smamEmpanelled Boolean @default(false)

  active        Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  equipment Equipment[]

  // The catalogue loader's identity for a dealer, enforced here so concurrent
  // runs cannot insert the same partner twice. Name alone is deliberately not
  // unique: a chain with branches in two states is two dealers, each with its
  // own phone number and stock.
  @@unique([name, state])
}

// =============================================================================
// Model 14: Equipment — A machine offered for sale, hire, or both
// =============================================================================

model Equipment {
  id          String             @id @default(uuid())

  dealerId    String
  dealer      EquipmentDealer    @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  title       String             // e.g., "Mahindra 575 DI XP Plus"
  category    EquipmentCategory
  brand       String?
  modelName   String?            // `model` is a Prisma keyword — hence modelName
  condition   EquipmentCondition @default(NEW)
  yearMade    Int?               // Relevant for USED listings

  mode        EquipmentMode      @default(SALE)

  // Pricing. Which fields are set depends on `mode` — the service validates
  // that a SALE row has salePrice and a RENT row has at least one rent rate.
  salePrice        Float?
  rentPricePerDay  Float?
  rentPricePerHour Float?
  securityDeposit  Float?        // Refundable, rentals only
  currency         Currency      @default(INR)

  // Spec sheet. Free-form strings keep this flexible across a tractor and a
  // 2-inch pipe without a table per category.
  powerHp     Float?             // Horsepower, where it applies
  specs       String[]           // e.g., ["540 PTO RPM", "1600 kg lift"]

  description String?
  images      String[]

  location    String
  state       String

  active      Boolean            @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enquiries EquipmentEnquiry[]

  // Browse is always filtered by these — index the hot paths.
  @@index([category, active])
  @@index([state, active])

  // The catalogue loader's identity for a machine. Enforcing it here rather
  // than trusting the loader means two concurrent runs cannot both decide a
  // row is missing and insert it twice.
  @@unique([dealerId, title])
}

// =============================================================================
// Model 15: EquipmentEnquiry — A farmer's lead, handed to the dealer
// =============================================================================
// The whole point of the surface. Raising one is what unlocks the dealer's
// phone number for that farmer, so we capture the lead instead of letting the
// catalogue be scraped for contacts.

model EquipmentEnquiry {
  id          String        @id @default(uuid())

  equipmentId String
  equipment   Equipment     @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  userId      String        // Whoever raised it — usually a FARMER
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  intent      EnquiryIntent // Buying or hiring — a BOTH listing needs this
  message     String?

  // Rental window, when intent = RENT. Advisory only; the dealer confirms
  // availability offline since we hold no booking calendar.
  rentFrom    DateTime?
  rentTo      DateTime?

  status      EnquiryStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}
